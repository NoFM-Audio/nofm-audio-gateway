map $http_upgrade $nofm_connection {
    default upgrade;
    '' close;
}
upstream nofm_origin {
    server ${NOFM_UPSTREAM};
    keepalive 8;
}
server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1k;

    # The visitor gateway is read-only, including when a valid admin token is supplied.
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_buffering off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;

    # Local process health only; this deliberately does not probe the audio server.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location = / { return 302 /cast/; }
    location = /cast/ws {
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nofm_connection;
        proxy_pass http://nofm_origin;
    }
    location ~ ^/cast/(index\.html|style\.css|player\.js|playback\.js)?$ {
        proxy_pass http://nofm_origin;
    }
    location ~ ^/cast/api/(status|time|player-config)$ {
        proxy_pass http://nofm_origin;
    }
    location /cast/audio/ {
        # No URI suffix/rewrite: preserve the original encoded filename, including %2F.
        proxy_pass http://nofm_origin;
    }
    location / { return 404; }
}
